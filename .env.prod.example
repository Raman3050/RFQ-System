# Copy to .env.prod and fill in. Never commit .env.prod.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
POSTGRES_PASSWORD=change-me

# Public URL users open (used in email links)
FRONTEND_BASE_URL=http://localhost:8088

# Outbound email (defaults to the bundled Mailpit catcher)
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=RFQ Auctions <no-reply@rfq-auctions.local>

# Host ports
WEB_PORT=8088
MAILPIT_UI_PORT=8026
