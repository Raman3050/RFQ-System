# Used when running the backend directly on the host (outside docker).
ENVIRONMENT=local
LOG_JSON=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://rfq:rfq@localhost:5432/rfq_auction
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]

# Auth. In staging/production JWT_SECRET_KEY (32+ random chars) and
# REFRESH_COOKIE_SECURE=true are mandatory; the app refuses to start otherwise.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-insecure-jwt-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_SECURE=false
